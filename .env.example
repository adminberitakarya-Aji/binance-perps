# =================================================================
# KREDENSIAL BINANCE USDⓈ-M FUTURES (WAJIB)
# =================================================================
# Testnet: buat API key di https://testnet.binancefuture.com
# Mainnet: buat API key di https://www.binance.com (Futures API)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true
BINANCE_SYMBOL=BTCUSDT

# =================================================================
# TIMEFRAME TRADING
# =================================================================
# Candle timeframe yang digunakan strategi.
# Pilihan: 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d
# Catatan: Bot secara otomatis menyesuaikan poll interval ke boundary candle.
# Contoh: TRADING_INTERVAL=15m -> bot poll setiap 15 menit setelah candle close
TRADING_INTERVAL=1h

# =================================================================
# TELEGRAM NOTIFIER (OPSIONAL - KOSONGKAN UNTUK MODE SILENT)
# =================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =================================================================
# MACHINE LEARNING FILTER (Fase 2 - RandomForest ONNX)
# =================================================================
# true = filter ML ON (hanya eksekusi jika p(win) >= threshold)
ML_FILTER_ENABLED=true
# Ambang probabilitas menang minimum (0.50 - 0.70)
ML_THRESHOLD=0.50
# Model path (kosongkan untuk default models/btcusdt_ml_rf_1h.onnx)
ML_MODEL_PATH=

# =================================================================
# MODE TP/SL: "atr" (adaptif volatilitas) atau "pct" (% harga tetap)
# =================================================================
# atr = SL/TP dihitung dari ATR candle - adaptif, cocok untuk TF 1H ke atas
# pct = SL/TP dihitung dari % harga entry - konsisten, cocok untuk TF 15M/30M
TPSL_MODE=atr

# --- Parameter TP/SL berbasis ATR (aktif jika TPSL_MODE=atr) ---
# Jarak Stop Loss awal dalam kelipatan ATR (2.0 = 2x ATR)
ATR_SL_MULT=2.0
# Jarak Take Profit awal (1.5 = 1.5x jarak SL, misal RR 1:1.5)
TP_RR_RATIO=1.5

# --- Parameter TP/SL berbasis % harga (aktif jika TPSL_MODE=pct) ---
# Stop Loss = SL_PCT% dari harga entry (misal 0.5 = SL di 0.5% bawah entry)
SL_PCT=0.5
# Take Profit = TP_PCT% dari harga entry (misal 1.0 = TP di 1.0% atas entry)
TP_PCT=1.0

# =================================================================
# RISK MANAGEMENT & POSITION SIZING
# =================================================================
# Persentase risiko modal per trade (0.01 = 1% equity)
RISK_PER_TRADE_PCT=0.01
# Batas leverage notional maksimum (cap 3x equity)
MAX_LEVERAGE=3.0
# Kill switch harian otomatis (-0.05 = cut trading jika rugi harian >= 5%)
MAX_DAILY_LOSS_PCT=0.05

# =================================================================
# SMART DCA / AVERAGING DOWN (GRID TERBATAS)
# =================================================================
# true = aktifkan penambahan lapis saat floating minus
DCA_ENABLED=true
# Maksimal jumlah lapis (termasuk entry awal, rekomendasi: 2 - 3)
DCA_MAX_ORDERS=3
# --- Jarak DCA (mengikuti TPSL_MODE yang dipilih) ---
# Mode ATR: jarak lapis = ATR * DCA_STEP_ATR_MULT dari lapis sebelumnya
DCA_STEP_ATR_MULT=1.5
# Mode PCT: jarak lapis = DCA_STEP_PCT% dari harga lapis sebelumnya
DCA_STEP_PCT=0.5
# Pengali lot lapis berikutnya (1.0 = equal sizing, 1.2 = sedikit diperbesar)
DCA_LOT_MULTIPLIER=1.0
# Take Profit gabungan dari Average Price (1.0 = 1.0x ATR / % di atas/bawah avg price)
DCA_TP_RR_RATIO=1.5
# Cut Loss Darurat: tutup seluruh keranjang jika floating loss >= 3% equity
DCA_HARD_SL_EQUITY_PCT=0.03

# =================================================================
# AVERAGE-PRICE TRAILING STOP
# =================================================================
# true = aktifkan trailing stop berbasis harga rata-rata
TRAILING_ENABLED=true
# Mulai trailing setelah profit >= ATR * mult dari average entry price
TRAILING_START_ATR_MULT=1.5
# Jarak Stop Loss baru di belakang harga pasar berjalan (1.0x ATR)
TRAILING_DISTANCE_ATR_MULT=1.0
# Minimal pergeseran harga untuk update trigger SL (0.3x ATR anti-churn)
TRAILING_STEP_ATR_MULT=0.3
